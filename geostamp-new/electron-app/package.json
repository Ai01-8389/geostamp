{
  "name": "geostamp-desktop",
  "version": "1.0.0",
  "description": "GeoStamp Desktop App - Process unlimited photos with GPS geotagging",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "exifreader": "^4.21.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.geostamp.desktop",
    "productName": "GeoStamp",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "renderer.js",
      "package.json",
      "node_modules/"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns"
    },
    "linux": {
      "target": "deb"
    }
  }
}