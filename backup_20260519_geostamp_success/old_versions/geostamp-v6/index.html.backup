otate': 'Аннотировать', 'btn-download-all': 'Скачать все',        'privacy-text': 'Локальная обработка', 'instructions-title': 'Как это работает',        'step1-title': 'Загрузить изображения', 'step1-desc': 'Перетащите или нажмите',        'step2-title': 'Выбрать именование', 'step2-desc': 'Выберите схему именования',        'step3-title': 'Скачать', 'step3-desc': 'Получите геотеггированные изображения',        'comparison-title': 'До / После', 'comparison-original': 'Оригинал', 'comparison-annotated': 'Аннотирован',        'results-title': 'Аннотированные изображения', 'pricing-title': 'Подписка', 'pricing-price': '7,99 $',        'pricing-period': 'в месяц', 'pricing-feature1': 'Безлимитная обработка', 'pricing-feature2': 'Выход HD',        'pricing-feature3': 'Пакетная обработка', 'pricing-feature4': 'Приоритетная поддержка', 'pricing-btn': 'Подписаться',        'desktop-title': 'Десктопное приложение', 'desktop-subtitle': 'Скоро', 'desktop-desc': 'Оффлайн-обработка',        'desktop-badge': 'Скоро', 'naming-title': 'Именование файла', 'naming-date': 'Дата_Номер', 'naming-date-desc': '20240115_001.jpg',        'naming-original': 'Имя файла', 'naming-original-desc': 'Сохранить имя', 'naming-gps': 'GPS-координаты', 'naming-gps-desc': '38.93_121.60_001.jpg',        'naming-custom': 'Пользовательский префикс', 'naming-custom-desc': 'Введите текст', 'naming-cancel': 'Отмена', 'naming-confirm': 'Аннотировать',        'loading-text': 'Обработка...', 'toast-success': 'Готово!'      },      ar: {        'nav-features': '???????', 'nav-pricing': '???????', 'nav-desktop': '??? ??????', 'nav-started': '????',        'panel-upload': '??? ?????', 'upload-title': '???? ????? ??? ???', 'upload-desc': '?? ???? ??????',        'empty-preview-text': '?? ?????? ?????', 'btn-annotate': '????? ?????', 'btn-download-all': '????? ????',        'privacy-text': '?????? ?????', 'instructions-title': '??? ????',        'step1-title': '??? ?????', 'step1-desc': '???? ?? ????',        'step2-title': '???? ???????', 'step2-desc': '??? ????? ???????',        'step3-title': '?????', 'step3-desc': '???? ??? ????? ????????',        'comparison-title': '??? / ???', 'comparison-original': '?????', 'comparison-annotated': '??????',        'results-title': '????? ?????????', 'pricing-title': '????????', 'pricing-price': '7.99 ?????',        'pricing-period': '?? ?????', 'pricing-feature1': '?????? ??? ?????', 'pricing-feature2': '????? HD',        'pricing-feature3': '?????? ???????', 'pricing-feature4': '??? ????', 'pricing-btn': '????? ????',        'desktop-title': '????? ??? ??????', 'desktop-subtitle': '??????', 'desktop-desc': '?????? ??? ?????',        'desktop-badge': '??????', 'naming-title': '????? ?????', 'naming-date': '???????_?????', 'naming-date-desc': '20240115_001.jpg',        'naming-original': '??? ????? ??????', 'naming-original-desc': '???? ?????', 'naming-gps': '???????? GPS', 'naming-gps-desc': '38.93_121.60_001.jpg',        'naming-custom': '??????? ???????', 'naming-custom-desc': '???? ????', 'naming-cancel': '?????', 'naming-confirm': '?????',        'loading-text': '???? ????????...', 'toast-success': '?????!'      }    };    let currentLang = 'en';    let selectedFiles = [];    let processedImages = [];    let currentNamingRule = 'date';    let currentCustomPrefix = '';    let showDebug = false;    let isSubscriber = false;    const MAX_FREE_IMAGES = 1;    const geocodeCache = new Map();    function debugLog(message) {      const logDiv = document.getElementById('debug-log');      if (!logDiv) return;      const entry = document.createElement('div');      entry.className = 'log-entry';      const time = new Date().toLocaleTimeString();      entry.textContent = `[${time}] ${message}`;      logDiv.appendChild(entry);      logDiv.scrollTop = logDiv.scrollHeight;      console.log(message);    }    function toggleDebugPanel() {      showDebug = !showDebug;      const panel = document.getElementById('debug-panel');      if (panel) {        if (showDebug) panel.classList.add('show');        else panel.classList.remove('show');      }    }    function toggleLangDropdown() {      const dropdown = document.getElementById('lang-dropdown');      if (dropdown) dropdown.classList.toggle('show');    }    function setLanguage(lang) {      currentLang = lang;      const trans = translations[lang];      const flags = { 'en': '????', 'zh': '????', 'fr': '????', 'es': '????', 'ru': '????', 'ar': '????' };      const codes = { 'en': 'EN', 'zh': '中文', 'fr': 'FR', 'es': 'ES', 'ru': 'RU', 'ar': 'AR' };      const flagEl = document.getElementById('lang-flag');      const codeEl = document.getElementById('lang-code');      const dropdown = document.getElementById('lang-dropdown');            if (flagEl) flagEl.textContent = flags[lang];      if (codeEl) codeEl.textContent = codes[lang];      if (dropdown) dropdown.classList.remove('show');            Object.keys(trans).forEach(key => {        const el = document.getElementById(key);        if (el) el.textContent = trans[key];      });            const toastText = document.getElementById('toast-text');      const loadingText = document.getElementById('loading-text');      if (toastText) toastText.textContent = trans['toast-success'];      if (loadingText) loadingText.textContent = trans['loading-text'];            document.documentElement.lang = lang;      document.body.style.direction = lang === 'ar' ? 'rtl' : 'ltr';    }    function handleFileSelect(e) {       const files = Array.from(e.target.files).filter(f => f.type.startsWith('image/'));       if (!isSubscriber && files.length > MAX_FREE_IMAGES) {        showToast(`Free users can only process ${MAX_FREE_IMAGES} image at a time. Subscribe for unlimited batch processing.`);        return;      }      if (!isSubscriber) {        selectedFiles = files.slice(0, MAX_FREE_IMAGES);      } else {        selectedFiles = files;      }      updatePreview();     }    function handleDrop(e) {       e.preventDefault();       e.currentTarget.classList.remove('active');       const files = Array.from(e.dataTransfer.files).filter(f => f.type.startsWith('image/'));       if (files.length > 0) {         if (!isSubscriber && files.length > MAX_FREE_IMAGES) {          showToast(`Free users can only process ${MAX_FREE_IMAGES} image at a time. Subscribe for unlimited batch processing.`);          return;        }        if (!isSubscriber) {          selectedFiles = files.slice(0, MAX_FREE_IMAGES);        } else {          selectedFiles = [...selectedFiles, ...files];        }        updatePreview();       }     }    function updatePreview() {      const preview = document.getElementById('preview-container');      const emptyPreview = document.getElementById('empty-preview');      const processBtn = document.getElementById('process-btn');      const downloadBtn = document.getElementById('download-all-btn');      if (!preview || !emptyPreview || !processBtn || !downloadBtn) return;      if (selectedFiles.length > 0) {        preview.style.display = 'grid';         emptyPreview.style.display = 'none';                const exceedsLimit = !isSubscriber && selectedFiles.length > MAX_FREE_IMAGES;        processBtn.disabled = exceedsLimit;         downloadBtn.disabled = true;                if (exceedsLimit) {          processBtn.title = `Free users can only process ${MAX_FREE_IMAGES} images at once. Subscribe for unlimited batch processing.`;        } else {          processBtn.title = '';        }        preview.innerHTML = '';        selectedFiles.slice(0, 6).forEach((file, i) => {          const item = document.createElement('div');           item.className = 'preview-item';          const img = document.createElement('img');           img.src = URL.createObjectURL(file);          const filename = document.createElement('span');           filename.className = 'filename';           filename.textContent = file.name;          item.appendChild(img);           item.appendChild(filename);           preview.appendChild(item);        });        if (selectedFiles.length > 6) {          const more = document.createElement('div');           more.className = 'preview-item';          more.style.display = 'flex';           more.style.alignItems = 'center';           more.style.justifyContent = 'center';           more.style.color = '#71717a';          more.textContent = `+${selectedFiles.length - 6}`;           preview.appendChild(more);        }      } else {         preview.style.display = 'none';         emptyPreview.style.display = 'block';         processBtn.disabled = true;         downloadBtn.disabled = true;       }    }    function showNamingModal() {       const overlay = document.getElementById('naming-modal-overlay');      if (overlay) overlay.classList.add('show');     }    function hideNamingModal() {       const overlay = document.getElementById('naming-modal-overlay');      if (overlay) overlay.classList.remove('show');     }    function confirmNaming() {      const checked = document.querySelector('input[name="naming-rule-modal"]:checked');      const customInput = document.getElementById('custom-prefix-modal');            if (checked) currentNamingRule = checked.value;      if (customInput) currentCustomPrefix = customInput.value.trim();            hideNamingModal();       processImages();    }    async function extractExif(file) {      try {        debugLog(`Processing file: ${file.name} (${file.size} bytes)`);        const buffer = await file.arrayBuffer();        const result = { hasExif: false, gps: null, location: null, placeName: null, timestamp: null };        const dataView = new DataView(buffer);                if (dataView.getUint16(0) !== 0xFFD8) {          debugLog('Not a JPEG file');          return result;        }                let offset = 2;        while (offset < buffer.byteLength - 2) {          const marker = dataView.getUint16(offset);                    if (marker === 0xFFE1) {            const length = dataView.getUint16(offset + 2);            const exifOffset = offset + 4;            if (dataView.getUint32(exifOffset) === 0x45786966) {              debugLog('Found EXIF header');              const tiffOffset = exifOffset + 6;              const byteOrder = dataView.getUint16(tiffOffset);              const isLittleEndian = byteOrder === 0x4949;                            const tiffMarker = dataView.getUint16(tiffOffset + 2, isLittleEndian);                            if (tiffMarker === 0x002A) {                const firstIfdOffset = dataView.getUint32(tiffOffset + 4, isLittleEndian) + tiffOffset;                const exifData = parseTiffIfd(dataView, tiffOffset, firstIfdOffset, isLittleEndian);                if (exifData) {                  result.hasExif = true;                   result.timestamp = exifData.timestamp;                  if (exifData.gpsLatitude !== undefined && exifData.gpsLongitude !== undefined) {                    const lat = exifData.gpsLatitude;                    const lng = exifData.gpsLongitude;                    debugLog(`GPS Coords found: ${lat}, ${lng}`);                    if (!isNaN(lat) && !isNaN(lng) && lat >= -90 && lat <= 90 && lng >= -180 && lng <= 180) {                      result.gps = { lat, lng };                       result.location = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;                    }                  }                }              }              break;            }          }          offset += dataView.getUint16(offset + 2) + 2;        }        return result;      } catch (e) {        debugLog(`EXIF error: ${e.message}`);        return { hasExif: false, gps: null, location: null, placeName: null, timestamp: null };      }    }    function parseTiffIfd(dataView, tiffOffset, ifdOffset, isLittleEndian) {      const result = {};      const entries = dataView.getUint16(ifdOffset, isLittleEndian);      let entryOffset = ifdOffset + 2;      for (let i = 0; i < entries; i++) {        const tag = dataView.getUint16(entryOffset, isLittleEndian);        const format = dataView.getUint16(entryOffset + 2, isLittleEndian);        const count = dataView.getUint32(entryOffset + 4, isLittleEndian);        let valueOffset = dataView.getUint32(entryOffset + 8, isLittleEndian);        if (count * getFormatSize(format) <= 4) valueOffset = entryOffset + 8;        else valueOffset += tiffOffset;        if (tag === 0x0132) result.timestamp = readString(dataView, valueOffset, count);        else if (tag === 0x8769) {          const exifIfdOffset = dataView.getUint32(valueOffset, isLittleEndian) + tiffOffset;          Object.assign(result, parseTiffIfd(dataView, tiffOffset, exifIfdOffset, isLittleEndian));        } else if (tag === 0x8825) {          const gpsIfdOffset = dataView.getUint32(valueOffset, isLittleEndian) + tiffOffset;          Object.assign(result, parseGpsIfd(dataView, tiffOffset, gpsIfdOffset, isLittleEndian));        }        entryOffset += 12;      }      const nextIfd = dataView.getUint32(entryOffset, isLittleEndian);      if (nextIfd !== 0) Object.assign(result, parseTiffIfd(dataView, tiffOffset, nextIfd + tiffOffset, isLittleEndian));      return result;    }    function parseGpsIfd(dataView, tiffOffset, ifdOffset, isLittleEndian) {      const result = {};      const entries = dataView.getUint16(ifdOffset, isLittleEndian);      let entryOffset = ifdOffset + 2;      let latRef, lonRef, latDegNum, latDegDen, latMinNum, latMinDen, latSecNum, latSecDen;      let lonDegNum, lonDegDen, lonMinNum, lonMinDen, lonSecNum, lonSecDen;      for (let i = 0; i < entries; i++) {        const tag = dataView.getUint16(entryOffset, isLittleEndian);        const format = dataView.getUint16(entryOffset + 2, isLittleEndian);        const count = dataView.getUint32(entryOffset + 4, isLittleEndian);        let valueOffset = dataView.getUint32(entryOffset + 8, isLittleEndian);        if (count * getFormatSize(format) <= 4) valueOffset = entryOffset + 8;        else valueOffset += tiffOffset;        switch (tag) {          case 0x0001: latRef = String.fromCharCode(dataView.getUint8(valueOffset)); break;          case 0x0002: if (format === 5 && count === 3) {            latDegNum = dataView.getUint32(valueOffset, isLittleEndian);             latDegDen = dataView.getUint32(valueOffset + 4, isLittleEndian);            latMinNum = dataView.getUint32(valueOffset + 8, isLittleEndian);             latMinDen = dataView.getUint32(valueOffset + 12, isLittleEndian);            latSecNum = dataView.getUint32(valueOffset + 16, isLittleEndian);             latSecDen = dataView.getUint32(valueOffset + 20, isLittleEndian);          } break;          case 0x0003: lonRef = String.fromCharCode(dataView.getUint8(valueOffset)); break;          case 0x0004: if (format === 5 && count === 3) {            lonDegNum = dataView.getUint32(valueOffset, isLittleEndian);             lonDegDen = dataView.getUint32(valueOffset + 4, isLittleEndian);            lonMinNum = dataView.getUint32(valueOffset + 8, isLittleEndian);             lonMinDen = dataView.getUint32(valueOffset + 12, isLittleEndian);            lonSecNum = dataView.getUint32(valueOffset + 16, isLittleEndian);             lonSecDen = dataView.getUint32(valueOffset + 20, isLittleEndian);          } break;        }        entryOffset += 12;      }      if (latDegNum !== undefined) {        const latDeg = latDegNum / latDegDen;        const latMin = latMinNum / latMinDen;        const latSec = latSecNum / latSecDen;        let lat = latDeg + latMin/60 + latSec/3600;        if (latRef === 'S') lat = -lat;        result.gpsLatitude = lat;      }      if (lonDegNum !== undefined) {        const lonDeg = lonDegNum / lonDegDen;        const lonMin = lonMinNum / lonMinDen;        const lonSec = lonSecNum / lonSecDen;        let lon = lonDeg + lonMin/60 + lonSec/3600;        if (lonRef === 'W') lon = -lon;        result.gpsLongitude = lon;      }      return result;    }    function getFormatSize(format) {      const sizes = [0, 1, 1, 2, 4, 8, 1, 1, 2, 4, 8, 4, 8, 4, 8];      return sizes[format] || 0;    }    function readString(dataView, offset, length) {      let str = '';      for (let i = 0; i < length; i++) {        const char = dataView.getUint8(offset + i);        if (char === 0) break;        str += String.fromCharCode(char);      }      return str;    }        async function reverseGeocode(lat, lng) {      const cacheKey = ${lat.toFixed(4)},;      if (geocodeCache.has(cacheKey)) {        return geocodeCache.get(cacheKey);      }      const timeout = (ms) => new Promise((_, reject) => setTimeout(() => reject(new Error('Timeout')), ms));      const tryGeocodingService = async (url, params) => {        const queryString = new URLSearchParams(params).toString();        const response = await Promise.race([          fetch(${url}, {            headers: { 'User-Agent': 'GeoStamp/1.0' },            timeout: 15000          }),          timeout(15000)        ]);        return await response.json();      };      const services = [        {          name: 'OpenStreetMap CN',          url: 'https://nominatim.openstreetmap.org/reverse?',          params: { format: 'json', lat, lon: lng, zoom: 18, addressdetails: 1 },          extract: (data) => {            if (!data.address) return null;            const parts = [];            if (data.address.city || data.address.town || data.address.village) {              parts.push(data.address.city || data.address.town || data.address.village);            }            if (data.address.state) parts.push(data.address.state);            if (data.address.country) parts.push(data.address.country);            return parts.filter(Boolean).join(' ');          }        },        {          name: 'OpenStreetMap Alt',          url: 'https://nominatim.openstreetmap.org/reverse?',          params: { format: 'json', lat, lon: lng, zoom: 16, addressdetails: 1 },          extract: (data) => data.display_name || null        },        {          name: 'OpenStreetMap Basic',          url: 'https://nominatim.openstreetmap.org/reverse?',          params: { format: 'json', lat, lon: lng, zoom: 14, addressdetails: 0 },          extract: (data) => data.display_name || null        }      ];      for (let i = 0; i < services.length; i++) {        const service = services[i];        try {          const response = await tryGeocodingService(service.url, service.params);          const placeName = service.extract(response);          if (placeName && placeName.trim()) {            geocodeCache.set(cacheKey, placeName);            return placeName;          }        } catch (e) {          console.log(Geocoding service failed: );        }      }      const fallbackName = formatAddressFromCoords(lat, lng);      geocodeCache.set(cacheKey, fallbackName);      return fallbackName;    }    function formatAddressFromCoords(lat, lng) {      let address = '';      if (lng >= 73.5 && lng <= 135 && lat >= 18 && lat <= 53) {        const regions = [          { name: '北京', minLat: 39.4, maxLat: 41.1, minLng: 115.4, maxLng: 117.5 },          { name: '上海', minLat: 30.5, maxLat: 31.8, minLng: 120.8, maxLng: 122.2 },          { name: '广州', minLat: 22.5, maxLat: 23.5, minLng: 112.5, maxLng: 114.5 },          { name: '深圳', minLat: 22.4, maxLat: 22.8, minLng: 113.7, maxLng: 114.3 },          { name: '杭州', minLat: 30.0, maxLat: 30.5, minLng: 120.0, maxLng: 120.4 },          { name: '成都', minLat: 30.4, maxLat: 31.2, minLng: 103.5, maxLng: 104.2 },          { name: '重庆', minLat: 29.1, maxLat: 30.4, minLng: 105.5, maxLng: 107.0 },          { name: '天津', minLat: 38.5, maxLat: 39.3, minLng: 116.7, maxLng: 117.5 },          { name: '南京', minLat: 31.5, maxLat: 32.2, minLng: 118.3, maxLng: 119.2 },          { name: '武汉', minLat: 30.3, maxLat: 30.8, minLng: 114.0, maxLng: 114.6 },          { name: '西安', minLat: 33.4, maxLat: 34.0, minLng: 108.7, maxLng: 109.3 },          { name: '青岛', minLat: 35.9, maxLat: 36.3, minLng: 120.2, maxLng: 120.5 },          { name: '大连', minLat: 38.7, maxLat: 39.5, minLng: 121.0, maxLng: 122.0 },          { name: '沈阳', minLat: 41.6, maxLat: 42.0, minLng: 123.0, maxLng: 123.8 },          { name: '苏州', minLat: 31.2, maxLat: 31.4, minLng: 120.5, maxLng: 120.7 },          { name: '郑州', minLat: 34.6, maxLat: 34.9, minLng: 113.5, maxLng: 113.8 },          { name: '长沙', minLat: 28.0, maxLat: 28.3, minLng: 112.8, maxLng: 113.1 },          { name: '哈尔滨', minLat: 45.7, maxLat: 45.9, minLng: 126.5, maxLng: 126.7 },          { name: '合肥', minLat: 31.7, maxLat: 31.9, minLng: 117.1, maxLng: 117.3 },          { name: '福州', minLat: 26.0, maxLat: 26.1, minLng: 119.2, maxLng: 119.4 },          { name: '厦门', minLat: 24.4, maxLat: 24.5, minLng: 118.1, maxLng: 118.2 },          { name: '昆明', minLat: 24.9, maxLat: 25.1, minLng: 102.6, maxLng: 102.8 },          { name: '贵阳', minLat: 26.5, maxLat: 26.7, minLng: 106.7, maxLng: 106.9 },          { name: '南宁', minLat: 22.8, maxLat: 23.0, minLng: 108.2, maxLng: 108.4 },          { name: '石家庄', minLat: 38.0, maxLat: 38.1, minLng: 114.4, maxLng: 114.6 },          { name: '太原', minLat: 37.8, maxLat: 37.9, minLng: 112.5, maxLng: 112.6 },          { name: '呼和浩特', minLat: 40.8, maxLat: 40.9, minLng: 111.6, maxLng: 111.8 },          { name: '兰州', minLat: 36.0, maxLat: 36.1, minLng: 103.8, maxLng: 103.9 },          { name: '西宁', minLat: 36.6, maxLat: 36.7, minLng: 101.7, maxLng: 101.8 },          { name: '乌鲁木齐', minLat: 43.8, maxLat: 43.9, minLng: 87.6, maxLng: 87.7 },          { name: '三亚', minLat: 18.2, maxLat: 18.3, minLng: 109.5, maxLng: 109.6 },          { name: '营口', minLat: 40.8, maxLat: 41.2, minLng: 122.5, maxLng: 123.0 },          { name: '锦州', minLat: 41.6, maxLat: 41.9, minLng: 123.5, maxLng: 124.2 },          { name: '丹东', minLat: 39.9, maxLat: 40.5, minLng: 124.0, maxLng: 124.5 },          { name: '盘锦', minLat: 40.2, maxLat: 40.7, minLng: 121.8, maxLng: 122.3 },          { name: '葫芦岛', minLat: 40.9, maxLat: 41.2, minLng: 121.5, maxLng: 122.2 },          { name: '铁岭', minLat: 42.0, maxLat: 42.5, minLng: 123.5, maxLng: 124.5 },          { name: '朝阳', minLat: 41.2, maxLat: 41.8, minLng: 119.5, maxLng: 120.5 },          { name: '鞍山', minLat: 40.3, maxLat: 41.0, minLng: 119.5, maxLng: 120.8 },          { name: '抚顺', minLat: 41.5, maxLat: 42.0, minLng: 123.5, maxLng: 124.5 },          { name: '本溪', minLat: 41.0, maxLat: 41.3, minLng: 120.8, maxLng: 121.5 },          { name: '四平', minLat: 43.0, maxLat: 43.5, minLng: 124.0, maxLng: 124.8 },          { name: '辽源', minLat: 42.5, maxLat: 43.0, minLng: 125.0, maxLng: 125.7 },          { name: '通化', minLat: 41.5, maxLat: 42.0, minLng: 125.5, maxLng: 126.2 },          { name: '白山', minLat: 41.5, maxLat: 42.2, minLng: 126.2, maxLng: 127.2 },          { name: '白城', minLat: 44.5, maxLat: 45.3, minLng: 124.0, maxLng: 125.5 },          { name: '松原', minLat: 45.0, maxLat: 45.8, minLng: 122.5, maxLng: 123.5 },          { name: '延边', minLat: 41.5, maxLat: 43.5, minLng: 128.0, maxLng: 131.0 },          { name: '济南', minLat: 36.4, maxLat: 36.8, minLng: 116.8, maxLng: 117.2 },          { name: '烟台', minLat: 37.2, maxLat: 37.8, minLng: 121.0, maxLng: 121.8 },          { name: '威海', minLat: 37.0, maxLat: 37.5, minLng: 121.8, maxLng: 122.5 },          { name: '潍坊', minLat: 36.4, maxLat: 36.9, minLng: 118.8, maxLng: 119.5 },          { name: '淄博', minLat: 36.5, maxLat: 36.9, minLng: 117.8, maxLng: 118.4 },          { name: '临沂', minLat: 34.8, maxLat: 35.5, minLng: 118.0, maxLng: 119.0 },          { name: '宁波', minLat: 29.8, maxLat: 30.0, minLng: 121.3, maxLng: 121.8 },          { name: '温州', minLat: 27.8, maxLat: 28.2, minLng: 120.4, maxLng: 121.0 },          { name: '无锡', minLat: 31.3, maxLat: 31.6, minLng: 120.0, maxLng: 120.5 },          { name: '佛山', minLat: 22.8, maxLat: 23.2, minLng: 112.8, maxLng: 113.2 },          { name: '珠海', minLat: 22.0, maxLat: 22.4, minLng: 113.2, maxLng: 113.8 },          { name: '东莞', minLat: 22.8, maxLat: 23.2, minLng: 113.5, maxLng: 114.0 },          { name: '中山', minLat: 22.4, maxLat: 22.8, minLng: 113.2, maxLng: 113.6 },        ];        for (const region of regions) {          if (lat >= region.minLat && lat <= region.maxLat && lng >= region.minLng && lng <= region.maxLng) {            address = region.name + ' 附近';            break;          }        }      }      if (!address) {        address = lat.toFixed(4) + 'N, ' + lng.toFixed(4) + 'E';      }      return address;    }    }    function generateFilename(exifData, index, rule) {      const date = exifData.timestamp ? exifData.timestamp.replace(/[:\s]/g, '') : 'UnknownDate';      const lat = exifData.gps ? exifData.gps.lat.toFixed(4) : '0';      const lng = exifData.gps ? exifData.gps.lng.toFixed(4) : '0';      const num = String(index + 1).padStart(3, '0');      switch (rule) {        case 'date': return `${date}_${num}.jpg`;        case 'gps': return `${lat}_${lng}_${num}.jpg`;        case 'custom': return `${currentCustomPrefix}_${num}.jpg`;        default: return `image_${num}.jpg`;      }    }    function showLoading(show) {      const overlay = document.getElementById('loading-overlay');      if (overlay) {        if (show) overlay.classList.add('show');        else overlay.classList.remove('show');      }    }    function updateProgress(percent) {      const fill = document.getElementById('progress-fill');      if (fill) fill.style.width = `${percent}%`;    }    function showToast(message) {      const toast = document.getElementById('toast');      const toastText = document.getElementById('toast-text');      if (toast && toastText) {        toastText.textContent = message;        toast.classList.add('show');        setTimeout(() => toast.classList.remove('show'), 3000);      }    }    async function processImages() {      if (selectedFiles.length === 0) return;      showLoading(true);      updateProgress(0);      processedImages = [];      for (let i = 0; i < selectedFiles.length; i++) {        const file = selectedFiles[i];        debugLog(`Processing ${i + 1}/${selectedFiles.length}: ${file.name}`);        const exifData = await extractExif(file);        debugLog(`EXIF result: ${JSON.stringify(exifData)}`);        if (exifData.gps) {          try {            const placeName = await reverseGeocode(exifData.gps.lat, exifData.gps.lng);            if (placeName) {              exifData.placeName = placeName;            }          } catch (e) {            debugLog(`Geocoding skipped: ${e.message}`);          }        }        const canvas = document.createElement('canvas');        const ctx = canvas.getContext('2d');        const img = new Image();                await new Promise((resolve, reject) => {          img.onload = resolve;          img.onerror = reject;          img.src = URL.createObjectURL(file);        });        canvas.width = img.width;        canvas.height = img.height + 120;        ctx.drawImage(img, 0, 0);        ctx.fillStyle = 'rgba(0,0,0,0.8)';        ctx.fillRect(0, img.height, img.width, 120);        ctx.fillStyle = 'white';        const fontSize = Math.max(24, Math.min(48, img.width / 40));        ctx.font = `${fontSize}px Arial, sans-serif`;                let label = exifData.placeName || exifData.location || 'Unknown Location';        if (exifData.timestamp) label += ` | ${exifData.timestamp}`;        label += ` | #${i + 1}`;                ctx.fillText(label, 24, img.height + 72);        const annotatedBlob = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.95));        const annotatedFile = new File([annotatedBlob], generateFilename(exifData, i, currentNamingRule), { type: 'image/jpeg' });        processedImages.push(annotatedFile);                updateProgress(((i + 1) / selectedFiles.length) * 100);        URL.revokeObjectURL(img.src);      }      showLoading(false);      displayResults();      showToast(translations[currentLang]['toast-success'] || 'Processing complete!');    }    function displayResults() {      const resultsGrid = document.getElementById('results-grid');      const emptyResults = document.getElementById('empty-results');      if (!resultsGrid || !emptyResults) return;      if (processedImages.length > 0) {        resultsGrid.innerHTML = '';        emptyResults.style.display = 'none';        processedImages.forEach((file, index) => {          const card = document.createElement('div');          card.className = 'result-card';          card.innerHTML = `            <img src="${URL.createObjectURL(file)}" alt="${file.name}">            <div class="info">              <span class="name">${file.name}</span>              <button class="download-btn" data-index="${index}">                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>              </button>            </div>          `;          resultsGrid.appendChild(card);        });        document.querySelectorAll('.download-btn').forEach(btn => {          btn.addEventListener('click', (e) => {            const index = parseInt(e.currentTarget.dataset.index);            downloadImage(index);          });        });      } else {        resultsGrid.innerHTML = '';        emptyResults.style.display = 'block';      }    }    function downloadImage(index) {      try {        const file = processedImages[index];        if (!file) {          debugLog('No file found for index: ' + index);          return;        }        const url = URL.createObjectURL(file);        const link = document.createElement('a');        link.href = url;        link.download = file.name;        document.body.appendChild(link);        link.click();        document.body.removeChild(link);        setTimeout(() => {          URL.revokeObjectURL(url);          debugLog('Download complete: ' + file.name);        }, 100);      } catch (e) {        debugLog('Download error: ' + e.message);        showToast('Download failed. Please try again.');      }    }    function downloadAll() {      if (processedImages.length === 0) {        showToast('No images to download');        return;      }      debugLog('Downloading ' + processedImages.length + ' images');      processedImages.forEach((file, index) => {        setTimeout(() => downloadImage(index), index * 500);      });    }    // Initialize    document.addEventListener('DOMContentLoaded', () => {      document.getElementById('lang-btn')?.addEventListener('click', toggleLangDropdown);      document.querySelectorAll('.lang-option').forEach(opt => {        opt.addEventListener('click', () => setLanguage(opt.dataset.lang));      });      const uploadArea = document.getElementById('upload-area');      const fileInput = document.getElementById('file-input');      uploadArea?.addEventListener('click', () => fileInput?.click());      uploadArea?.addEventListener('dragover', (e) => { e.preventDefault(); uploadArea.classList.add('active'); });      uploadArea?.addEventListener('dragleave', () => uploadArea.classList.remove('active'));      uploadArea?.addEventListener('drop', handleDrop);      uploadArea?.addEventListener('click', () => fileInput?.click());      fileInput?.addEventListener('change', handleFileSelect);      document.getElementById('process-btn')?.addEventListener('click', showNamingModal);      document.getElementById('download-all-btn')?.addEventListener('click', downloadAll);      document.getElementById('naming-cancel')?.addEventListener('click', hideNamingModal);      document.getElementById('naming-confirm')?.addEventListener('click', confirmNaming);      document.querySelectorAll('.naming-modal .option').forEach(opt => {        opt.addEventListener('click', () => {          document.querySelectorAll('.naming-modal .option').forEach(o => o.classList.remove('selected'));          opt.classList.add('selected');          opt.querySelector('input').checked = true;                    const customInput = document.getElementById('custom-prefix-modal');          if (opt.querySelector('input').value === 'custom') {            customInput?.classList.add('show');          } else {            customInput?.classList.remove('show');          }        });      });      document.getElementById('toggle-debug')?.addEventListener('click', toggleDebugPanel);    });  </script></body></html>