<!DOCTYPE html><html lang="en"><head>  <meta charset="UTF-8">  <meta name="viewport" content="width=device-width, initial-scale=1.0">  <title>GeoStamp - Image Geotagging</title>  <style>    * { margin: 0; padding: 0; box-sizing: border-box; }    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: linear-gradient(135deg, #0f0f1a 0%, #1a1a2e 50%, #16213e 100%); min-height: 100vh; color: #e4e4e7; }    #app { min-height: 100vh; display: flex; flex-direction: column; }    header { padding: 14px 24px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.08); background: rgba(0,0,0,0.3); }    .logo { display: flex; align-items: center; gap: 10px; }    .logo svg { width: 32px; height: 32px; }    .logo span { font-weight: 600; font-size: 17px; background: linear-gradient(135deg, #8b5cf6, #06b6d4); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }    .nav-links { display: flex; gap: 24px; align-items: center; }    .nav-links a { text-decoration: none; color: #a1a1aa; font-size: 13px; font-weight: 500; transition: color 0.2s; }    .nav-links a:hover { color: #e4e4e7; }    .nav-links .btn { background: linear-gradient(135deg, #8b5cf6, #06b6d4); color: white; padding: 8px 18px; border-radius: 8px; font-size: 13px; font-weight: 500; }    .lang-selector { position: relative; }    .lang-selector .lang-btn { display: flex; align-items: center; gap: 6px; padding: 6px 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; cursor: pointer; font-size: 13px; color: #e4e4e7; }    .lang-selector .lang-btn:hover { background: rgba(255,255,255,0.1); }    .lang-dropdown { display: none; position: absolute; top: 100%; right: 0; margin-top: 8px; background: #1f1f2e; border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 8px; min-width: 140px; z-index: 100; }    .lang-dropdown.show { display: block; }    .lang-option { display: flex; align-items: center; gap: 8px; width: 100%; padding: 8px 12px; background: none; border: none; color: #e4e4e7; font-size: 13px; cursor: pointer; border-radius: 6px; text-align: left; }    .lang-option:hover { background: rgba(255,255,255,0.08); }    .main-content { flex: 1; display: grid; grid-template-columns: 1fr 1fr 2fr; grid-template-rows: 1.5fr 0.8fr 0.7fr; gap: 16px; padding: 20px; max-width: 1400px; margin: 0 auto; width: 100%; height: calc(100vh - 80px); box-sizing: border-box; }    .grid-item { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 16px; overflow: hidden; display: flex; flex-direction: column; }    .grid-item.comparison { grid-column: 1; grid-row: 1 / 3; }    .grid-item.upload { grid-column: 2; grid-row: 1; }    .grid-item.results { grid-column: 3; grid-row: 1 / 4; }    .grid-item.instructions { grid-column: 1; grid-row: 3; }    .grid-item.desktop { grid-column: 2; grid-row: 2; }    .grid-item.pricing { grid-column: 2; grid-row: 3; }    .panel-title { font-size: 15px; font-weight: 600; margin-bottom: 16px; color: #f4f4f5; }    .upload-area { background: rgba(255,255,255,0.03); border: 2px dashed rgba(255,255,255,0.15); border-radius: 10px; padding: 20px; text-align: center; cursor: pointer; transition: all 0.3s; margin-top: 16px; }    .upload-area:hover, .upload-area.active { border-color: #8b5cf6; background: rgba(139, 92, 246, 0.08); }    .upload-icon { width: 50px; height: 50px; background: rgba(255,255,255,0.05); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px; }    .upload-icon svg { width: 24px; height: 24px; color: #a1a1aa; }    .upload-area h3 { font-size: 14px; font-weight: 500; color: #e4e4e7; margin-bottom: 4px; }    .upload-area p { font-size: 12px; color: #71717a; }    #file-input { display: none; }    .preview-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 16px; }    .preview-item { aspect-ratio: 4/3; background: rgba(255,255,255,0.05); border-radius: 8px; overflow: hidden; position: relative; }    .preview-item img { width: 100%; height: 100%; object-fit: cover; }    .preview-item span { position: absolute; bottom: 0; left: 0; right: 0; background: rgba(0,0,0,0.7); color: white; padding: 4px; font-size: 10px; overflow: hidden; }    .action-buttons { display: flex; gap: 8px; margin-top: 12px; }    .btn { padding: 10px 20px; border-radius: 8px; font-size: 13px; font-weight: 500; border: none; cursor: pointer; transition: all 0.2s; }    .btn-primary { background: linear-gradient(135deg, #8b5cf6, #06b6d4); color: white; }    .btn-secondary { background: rgba(255,255,255,0.08); color: #e4e4e7; }    .btn:disabled { opacity: 0.5; cursor: not-allowed; }    .steps { display: flex; flex-direction: column; gap: 12px; margin-top: 16px; }    .step { display: flex; gap: 10px; }    .step-number { width: 22px; height: 22px; background: linear-gradient(135deg, #8b5cf6, #06b6d4); border-radius: 5px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 600; color: white; flex-shrink: 0; }    .step-title { font-size: 13px; font-weight: 500; color: #e4e4e7; margin-bottom: 2px; }    .step-desc { font-size: 11px; color: #71717a; }    .comparison-grid { display: flex; flex-direction: column; gap: 10px; margin-top: 16px; }    .comparison-item { aspect-ratio: 16/9; background: rgba(255,255,255,0.05); border-radius: 10px; overflow: hidden; position: relative; }    .comparison-item .label { position: absolute; top: 8px; left: 8px; background: rgba(0,0,0,0.7); color: white; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 500; }    .results-section { display: flex; flex-direction: column; }    .results-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 16px; overflow-y: auto; }    .result-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; overflow: hidden; }    .result-card img { width: 100%; aspect-ratio: 4/3; object-fit: cover; }    .result-card .info { padding: 10px 12px; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(255,255,255,0.08); }    .result-card .name { font-size: 12px; color: #a1a1aa; max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }    .download-btn { width: 32px; height: 32px; background: rgba(255,255,255,0.08); border-radius: 8px; display: flex; align-items: center; justify-content: center; cursor: pointer; border: none; }    .download-btn svg { width: 16px; height: 16px; color: #e4e4e7; }    .pricing-section { text-align: center; }    .pricing-section h3 { font-size: 15px; font-weight: 600; margin-bottom: 14px; color: #f4f4f5; }    .price { font-size: 28px; font-weight: 600; background: linear-gradient(135deg, #8b5cf6, #06b6d4); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }    .period { font-size: 12px; color: #71717a; margin-top: 4px; }    .pricing-section ul { margin-top: 16px; padding-left: 20px; text-align: left; }    .pricing-section li { padding: 4px 0; font-size: 12px; color: #a1a1aa; }    .pricing-section button { width: 100%; background: linear-gradient(135deg, #8b5cf6, #06b6d4); color: white; padding: 10px; border-radius: 8px; font-size: 13px; font-weight: 500; border: none; cursor: pointer; margin-top: 12px; }    .desktop-app { text-align: center; }    .desktop-app h3 { font-size: 15px; font-weight: 600; margin-bottom: 8px; color: #f4f4f5; }    .desktop-app .subtitle { font-size: 13px; color: #a78bfa; font-weight: 500; margin-top: 8px; }    .desktop-app p { font-size: 12px; color: #71717a; margin-top: 8px; }    .desktop-app .badge { display: inline-block; background: rgba(139, 92, 246, 0.15); color: #a78bfa; padding: 4px 10px; border-radius: 12px; font-size: 11px; margin-top: 12px; }    .privacy-badge { background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.2); border-radius: 6px; padding: 8px 10px; font-size: 11px; color: #86efac; display: flex; align-items: center; gap: 6px; margin-top: 10px; }    .naming-modal-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); backdrop-filter: blur(4px); justify-content: center; align-items: center; z-index: 1000; }    .naming-modal-overlay.show { display: flex; }    .naming-modal { background: #1f1f2e; border-radius: 16px; padding: 24px; width: 90%; max-width: 400px; border: 1px solid rgba(255,255,255,0.1); }    .naming-modal h3 { margin: 0 0 20px 0; font-size: 18px; color: #f4f4f5; font-weight: 600; }    .naming-modal .options { display: flex; flex-direction: column; gap: 12px; margin-bottom: 24px; }    .naming-modal .option { display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: rgba(255,255,255,0.03); border-radius: 10px; cursor: pointer; border: 2px solid transparent; }    .naming-modal .option.selected { background: rgba(139, 92, 246, 0.15); border-color: rgba(139, 92, 246, 0.5); }    .naming-modal .option .label { font-size: 14px; color: #e4e4e7; }    .naming-modal .option .desc { font-size: 12px; color: #71717a; }    .naming-modal .custom-input { margin-top: 8px; padding: 10px 14px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #e4e4e7; font-size: 14px; width: 100%; box-sizing: border-box; display: none; }    .naming-modal .custom-input.show { display: block; }    .naming-modal .buttons { display: flex; gap: 12px; }    .naming-modal .buttons button { flex: 1; padding: 12px; border-radius: 8px; font-size: 14px; font-weight: 500; cursor: pointer; border: none; }    .naming-modal .btn-cancel { background: rgba(255,255,255,0.08); color: #a1a1aa; }    .naming-modal .btn-confirm { background: linear-gradient(135deg, #8b5cf6, #06b6d4); color: white; }    .loading-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(8px); justify-content: center; align-items: center; z-index: 1000; }    .loading-overlay.show { display: flex; }    .loading-content { text-align: center; }    .loading-spinner { width: 48px; height: 48px; border: 3px solid rgba(255,255,255,0.1); border-top-color: #8b5cf6; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 20px; }    @keyframes spin { to { transform: rotate(360deg); } }    .progress-bar { width: 200px; height: 4px; background: rgba(255,255,255,0.1); border-radius: 2px; overflow: hidden; margin: 0 auto; }    .progress-fill { height: 100%; background: linear-gradient(90deg, #8b5cf6, #06b6d4); width: 0%; transition: width 0.3s; }    .toast { display: none; position: fixed; bottom: 24px; right: 24px; background: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.3); border-radius: 12px; padding: 14px 18px; align-items: center; gap: 10px; }    .toast.show { display: flex; animation: slideIn 0.3s ease; }    @keyframes slideIn { from { transform: translateX(100px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }    .debug-panel { position: fixed; bottom: 80px; left: 24px; background: rgba(0,0,0,0.85); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 12px; max-width: 400px; max-height: 300px; overflow-y: auto; z-index: 999; font-family: monospace; font-size: 11px; color: #86efac; display: none; }    .debug-panel.show { display: block; }    .debug-panel h4 { color: #f4f4f5; margin-bottom: 8px; font-size: 12px; }    .debug-panel .log-entry { padding: 4px 0; border-bottom: 1px solid rgba(255,255,255,0.1); }    .debug-panel .log-entry:last-child { border-bottom: none; }    @media (max-width: 900px) { .main-content { grid-template-columns: 1fr; grid-template-rows: auto; } .grid-item.comparison, .grid-item.upload, .grid-item.results, .grid-item.instructions, .grid-item.desktop, .grid-item.pricing { grid-column: 1; grid-row: auto; } }  </style></head><body>  <div id="app">    <header>      <div class="logo">        <svg viewBox="0 0 32 32" fill="none">          <defs><linearGradient id="logoGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:#8b5cf6"/><stop offset="100%" style="stop-color:#06b6d4"/></linearGradient></defs>          <rect width="32" height="32" rx="8" fill="url(#logoGrad)"/><path d="M8 12h16M8 16h12M8 20h14" stroke="#fff" stroke-width="2" stroke-linecap="round"/><circle cx="22" cy="22" r="4" fill="#fff"/>        </svg>        <span>GeoStamp</span>      </div>      <div class="nav-links">        <a href="#features" id="nav-features">Features</a>        <a href="#pricing" id="nav-pricing">Pricing</a>        <a href="#desktop" id="nav-desktop">Desktop</a>        <a href="#" class="btn" id="nav-started">Get Started</a>        <div class="lang-selector">          <button class="lang-btn" id="lang-btn">            <span id="lang-flag">????</span>            <span id="lang-code">EN</span>            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 5L6 8L9 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>          </button>          <div class="lang-dropdown" id="lang-dropdown">            <button class="lang-option" data-lang="en">???? English</button>            <button class="lang-option" data-lang="zh">???? 繁體中文</button>            <button class="lang-option" data-lang="fr">???? Fran?ais</button>            <button class="lang-option" data-lang="es">???? Espa?ol</button>            <button class="lang-option" data-lang="ru">???? Русский</button>            <button class="lang-option" data-lang="ar">???? ???????</button>          </div>        </div>      </div>    </header>    <div class="main-content">      <div class="grid-item comparison">        <h3 id="comparison-title">Before & After</h3>        <div class="comparison-grid">          <div class="comparison-item">            <div class="label" id="comparison-original">Original</div>            <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 225'%3E%3Crect fill='%231a1a2e' width='400' height='225'/%3E%3Crect fill='%232a2a4e' x='50' y='40' width='300' height='145' rx='8'/%3E%3Ccircle cx='200' cy='112' r='40' fill='%233a3a6e'/%3E%3C/svg%3E" alt="Before" style="width:100%;height:100%;object-fit:cover;">          </div>          <div class="comparison-item">            <div class="label" id="comparison-annotated">Annotated</div>            <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 225'%3E%3Crect fill='%231a1a2e' width='400' height='225'/%3E%3Crect fill='%232a2a4e' x='50' y='40' width='300' height='145' rx='8'/%3E%3Ccircle cx='200' cy='112' r='40' fill='%233a3a6e'/%3E%3Crect x='0' y='185' width='400' height='40' fill='rgba(0,0,0,0.7)'/%3E%3Ctext x='16' y='210' fill='white' font-size='12' font-family='Arial'%3EShanghai Bund | 2024-01-15 10:30 | #1%3C/text%3E%3C/svg%3E" alt="After" style="width:100%;height:100%;object-fit:cover;">          </div>        </div>      </div>      <div class="grid-item upload">        <h3 class="panel-title" id="panel-upload">Upload Images</h3>        <input type="file" id="file-input" accept="image/*" multiple>        <div class="upload-area" id="upload-area">          <div class="upload-icon">            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" /></svg>          </div>          <h3 id="upload-title">Drop images here</h3>          <p id="upload-desc">or click to browse</p>        </div>        <div id="preview-container" class="preview-grid" style="display: none;"></div>        <div id="empty-preview" style="text-align: center; padding: 12px 0; color: #71717a; font-size: 12px;"><p id="empty-preview-text">No images selected</p></div>        <div class="action-buttons">          <button id="process-btn" class="btn btn-primary" disabled><span id="btn-annotate">Annotate Images</span></button>          <button id="download-all-btn" class="btn btn-secondary" disabled><span id="btn-download-all">Download All</span></button>        </div>        <div class="privacy-badge"><span>??</span><span id="privacy-text">Your images are processed locally</span></div>        <div style="margin-top: 8px;">          <button id="toggle-debug" style="font-size: 10px; padding: 4px 8px; background: rgba(139, 92, 246, 0.2); border: 1px solid rgba(139, 92, 246, 0.4); color: #a78bfa; border-radius: 4px; cursor: pointer;">Toggle Debug</button>        </div>      </div>      <div class="grid-item results" id="results-section">        <h3 id="results-title">Annotated Images</h3>        <div id="results-grid" class="results-grid"></div>        <div id="empty-results" style="text-align: center; padding: 40px 0; color: #71717a; font-size: 12px;">          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" style="width: 40px; height: 40px; margin-bottom: 10px; opacity: 0.5;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>          <p>Process images to see results</p>        </div>      </div>      <div class="grid-item instructions">        <h3 id="instructions-title">How It Works</h3>        <div class="steps">          <div class="step">            <div class="step-number">1</div>            <div class="step-content">              <div class="step-title" id="step1-title">Upload Images</div>              <div class="step-desc" id="step1-desc">Drag or click to upload photos with GPS data</div>            </div>          </div>          <div class="step">            <div class="step-number">2</div>            <div class="step-content">              <div class="step-title" id="step2-title">Choose Naming</div>              <div class="step-desc" id="step2-desc">Select your preferred file naming convention</div>            </div>          </div>          <div class="step">            <div class="step-number">3</div>            <div class="step-content">              <div class="step-title" id="step3-title">Download</div>              <div class="step-desc" id="step3-desc">Get your geotagged images with location overlays</div>            </div>          </div>        </div>      </div>      <div class="grid-item desktop">        <div class="desktop-app">          <h3 id="desktop-title">Desktop App</h3>          <div class="subtitle" id="desktop-subtitle">Unlimited Processing</div>          <p id="desktop-desc">Download source code to build your own desktop app</p>          <div style="margin-top: 12px; display: flex; flex-direction: column; gap: 8px;">            <a href="GeoStamp-Electron-Source.zip" download class="download-link" style="display: flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 14px; background: rgba(139, 92, 246, 0.15); border-radius: 8px; color: #a78bfa; text-decoration: none; font-size: 13px;">              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>              Source Code (.zip)            </a>          </div>          <div style="margin-top: 10px; padding: 8px 10px; background: rgba(59, 130, 246, 0.15); border-radius: 6px; border: 1px solid rgba(59, 130, 246, 0.3);">            <div style="color: #60a5fa; font-size: 11px; text-align: center;">?? Build instructions included</div>          </div>        </div>      </div>      <div class="grid-item pricing">        <div class="pricing-section">          <h3 id="pricing-title">Subscription</h3>          <div class="price" id="pricing-price">$7.99</div>          <div class="period" id="pricing-period">per month</div>          <ul>            <li id="pricing-feature1">Unlimited image processing</li>            <li id="pricing-feature2">HD quality output</li>            <li id="pricing-feature3">Batch processing support</li>            <li id="pricing-feature4">Priority support</li>          </ul>          <button id="pricing-btn">Subscribe Now</button>        </div>      </div>    </div>    <div id="naming-modal-overlay" class="naming-modal-overlay">      <div class="naming-modal">        <h3 id="naming-title">File Naming</h3>        <div class="options">          <label class="option selected"><input type="radio" name="naming-rule-modal" value="date" checked><div><div class="label" id="naming-date">Date_Serial</div><div class="desc" id="naming-date-desc">20240115_001.jpg</div></div></label>          <label class="option"><input type="radio" name="naming-rule-modal" value="original"><div><div class="label" id="naming-original">Original Filename</div><div class="desc" id="naming-original-desc">Keep original name</div></div></label>          <label class="option"><input type="radio" name="naming-rule-modal" value="gps"><div><div class="label" id="naming-gps">GPS Coordinates</div><div class="desc" id="naming-gps-desc">38.93_121.60_001.jpg</div></div></label>          <label class="option"><input type="radio" name="naming-rule-modal" value="custom"><div><div class="label" id="naming-custom">Custom Prefix</div><div class="desc" id="naming-custom-desc">Enter custom text</div></div></label>        </div>        <input type="text" id="custom-prefix-modal" class="custom-input" placeholder="Enter custom prefix">        <div class="buttons"><button class="btn-cancel" id="naming-cancel">Cancel</button><button class="btn-confirm" id="naming-confirm">Annotate</button></div>      </div>    </div>    <div id="loading-overlay" class="loading-overlay">      <div class="loading-content"><div class="loading-spinner"></div><div class="loading-text" id="loading-text">Processing images...</div><div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div></div>    </div>    <div id="toast" class="toast"><span class="icon">?</span><span class="text" id="toast-text">Processing complete!</span></div>        <div id="debug-panel" class="debug-panel">      <h4>Debug Log</h4>      <div id="debug-log"></div>    </div>  </div>  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>  <script>    const translations = {      en: {        'nav-features': 'Features', 'nav-pricing': 'Pricing', 'nav-desktop': 'Desktop', 'nav-started': 'Get Started',        'panel-upload': 'Upload Images', 'upload-title': 'Drop images here', 'upload-desc': 'or click to browse',        'empty-preview-text': 'No images selected', 'btn-annotate': 'Annotate Images', 'btn-download-all': 'Download All',        'privacy-text': 'Your images are processed locally', 'instructions-title': 'How It Works',        'step1-title': 'Upload Images', 'step1-desc': 'Drag or click to upload photos with GPS data',        'step2-title': 'Choose Naming', 'step2-desc': 'Select your preferred file naming convention',        'step3-title': 'Download', 'step3-desc': 'Get your geotagged images with location overlays',        'comparison-title': 'Before & After', 'comparison-original': 'Original', 'comparison-annotated': 'Annotated',        'results-title': 'Annotated Images', 'pricing-title': 'Subscription', 'pricing-price': '$7.99',        'pricing-period': 'per month', 'pricing-feature1': 'Unlimited image processing', 'pricing-feature2': 'HD quality output',        'pricing-feature3': 'Batch processing support', 'pricing-feature4': 'Priority support', 'pricing-btn': 'Subscribe Now',        'desktop-title': 'Desktop App', 'desktop-subtitle': 'Coming Soon', 'desktop-desc': 'Offline processing for faster and more secure workflow',        'desktop-badge': 'Stay tuned', 'naming-title': 'File Naming', 'naming-date': 'Date_Serial', 'naming-date-desc': '20240115_001.jpg',        'naming-original': 'Original Filename', 'naming-original-desc': 'Keep original name', 'naming-gps': 'GPS Coordinates', 'naming-gps-desc': '38.93_121.60_001.jpg',        'naming-custom': 'Custom Prefix', 'naming-custom-desc': 'Enter custom text', 'naming-cancel': 'Cancel', 'naming-confirm': 'Annotate',        'loading-text': 'Processing images...', 'toast-success': 'Processing complete!'      },      zh: {        'nav-features': '功能', 'nav-pricing': '價格', 'nav-desktop': '桌面版', 'nav-started': '開始使用',        'panel-upload': '上傳圖片', 'upload-title': '拖曳圖片到這裡', 'upload-desc': '或點擊選擇檔案',        'empty-preview-text': '請選擇圖片', 'btn-annotate': '開始標註', 'btn-download-all': '下載全部',        'privacy-text': '圖片僅在瀏覽器處理', 'instructions-title': '使用方法',        'step1-title': '上傳圖片', 'step1-desc': '拖曳或點擊上傳包含GPS資訊的照片',        'step2-title': '選擇命名', 'step2-desc': '選擇您喜歡的檔案命名方式',        'step3-title': '下載', 'step3-desc': '取得帶地理位置標註的圖片',        'comparison-title': '效果對比', 'comparison-original': '原圖', 'comparison-annotated': '標註後',        'results-title': '已標註圖片', 'pricing-title': '訂閱服務', 'pricing-price': '$7.99',        'pricing-period': '每月', 'pricing-feature1': '無限圖片處理', 'pricing-feature2': '高品質圖片輸出',        'pricing-feature3': '批次處理支援', 'pricing-feature4': '優先技術支援', 'pricing-btn': '立即訂閱',        'desktop-title': '桌面應用', 'desktop-subtitle': '即將推出', 'desktop-desc': '離線處理，更快更安全',        'desktop-badge': '敬請期待', 'naming-title': '選擇命名規則', 'naming-date': '日期_序號', 'naming-date-desc': '20240115_001.jpg',        'naming-original': '原檔名', 'naming-original-desc': '保持原始檔名不變', 'naming-gps': 'GPS座標', 'naming-gps-desc': '38.93_121.60_001.jpg',        'naming-custom': '自訂前綴', 'naming-custom-desc': '輸入自訂文字', 'naming-cancel': '取消', 'naming-confirm': '確認',        'loading-text': '正在處理圖片...', 'toast-success': '處理完成！'      },      fr: {        'nav-feature